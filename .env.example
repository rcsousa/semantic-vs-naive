# ----------------------------------------------------------------------------
#  Copie para .env e preencha. Sem Azure OpenAI, a demo entra em modo MOCK
#  (respostas determinísticas). É 100% suficiente para a parte didática.
# ----------------------------------------------------------------------------

# === Azure OpenAI (opcional para modo real) ===
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=sk-...
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# === Backends ===
NEO4J_USER=neo4j
NEO4J_PASSWORD=demograph123
NEO4J_BROWSER_PORT=7474

POSTGRES_USER=bank
POSTGRES_PASSWORD=bank123
POSTGRES_DB=bankdb

# === Portas expostas ===
FRONTEND_PORT=3000
GATEWAY_PORT=8000

# === Frontend ===
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# === Misc ===
LOG_LEVEL=INFO
